// fluxcore.party: one Cloudflare Worker serving the static site that flasher/build.py writes to _site/.
// Deployed by .github/workflows/flasher.yml (wrangler deploy).
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "fluxcore-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-04",
  "assets": { "directory": "./_site", "binding": "ASSETS" },
  "routes": [{ "pattern": "fluxcore.party", "custom_domain": true }]
}
