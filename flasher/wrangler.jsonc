// Cloudflare Worker that serves the built flasher (static files only) at flash.fluxcore.party.
// The workflow builds the site into _site/ and deploys with: wrangler deploy -c flasher/wrangler.jsonc
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "fluxcore-flasher",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "../_site",
    // The flasher keeps its state in the path (/device/role/version): serve index.html for those
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "flash.fluxcore.party", "custom_domain": true }]
}
